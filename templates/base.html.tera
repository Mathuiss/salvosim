<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="color-scheme" content="light dark">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@picocss/pico@2/css/pico.min.css">
    <script src="https://unpkg.com/htmx.org@2.0.4"></script>
    <title>{% block title %}SalvoSim{% endblock %}</title>
</head>
<body>
    <header class="container">
        <nav>
            <ul>
                <li>
                    <a href="/" style="display: flex; align-items: center; gap: 0.5rem; --pico-text-decoration: none;">
                        <img src="/static/logo.png" alt="SalvoSim" height="28" width="28" style="display: block;">
                        <strong>SalvoSim</strong>
                    </a>
                </li>
            </ul>
            <ul>
                <li><a href="/">Dashboard</a></li>
            </ul>
        </nav>
    </header>

    <main class="container">
        {% block content %}{% endblock %}
    </main>
</body>
</html>
