{% extends "base" %}
{% block title %}SalvoSim — Dashboard{% endblock %}

{% block content %}
<h1>SalvoSim</h1>
<p>Universal Salvo Simulator — Web Interface</p>

<section>
    <h2>Scenarios</h2>

    {% if scenarios %}
    <article>
        <table>
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Description</th>
                    <th>Mode</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for s in scenarios %}
                <tr>
                    <td><a href="/scenarios/{{ s.name }}/edit">{{ s.display_name }}</a></td>
                    <td>{{ s.description }}</td>
                    <td>{{ s.execution_mode }}</td>
                    <td style="white-space: nowrap;">
                        <a href="/scenarios/{{ s.name }}/edit" class="button" role="button">Edit</a>
                        <button hx-post="/simulate/{{ s.name }}"
                                hx-target="body"
                                hx-swap="outerHTML"
                                hx-disabled-elt="this"
                                hx-indicator="#spinner"
                                class="small">
                            Run
                        </button>
                        <button hx-delete="/scenarios/{{ s.name }}"
                                hx-target="body"
                                hx-swap="outerHTML"
                                hx-confirm="Delete this scenario?"
                                class="small outline secondary">
                            Delete
                        </button>
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </article>
    {% else %}
    <p>No scenarios yet. <a href="/scenarios/new">Create one</a>.</p>
    {% endif %}

    <a href="/scenarios/new" role="button">New Scenario</a>
</section>
{% endblock %}
