{% extends "base" %}
{% block title %}Run Simulation — {{ name }}{% endblock %}

{% block content %}
<nav>
    <ul>
        <li><h1>Run Simulation</h1></li>
    </ul>
    <ul>
        <li><button type="button" class="secondary outline small"
                onclick="window.location='/'">Back to Dashboard</button></li>
    </ul>
</nav>

<p>Scenario: <strong>{{ name }}</strong></p>

<form method="post" action="/simulate/{{ name }}">
    <label for="iterations">Monte Carlo Iterations</label>
    <input type="number" id="iterations" name="iterations"
           value="{{ default_iterations }}" min="1" max="10000000" required>

    <div class="grid">
        <button type="submit">Simulate</button>
        <button type="button" class="outline"
                onclick="window.location='/scenarios/{{ name }}/edit'">Edit Scenario</button>
    </div>
</form>
{% endblock %}
