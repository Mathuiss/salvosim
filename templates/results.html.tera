{% extends "base" %}
{% block title %}SalvoSim — Results: {{ result.scenario_name }}{% endblock %}

{% block content %}
<style>
    .side-defenders th,
    .side-defenders .badge {
        color: #1a73e8;
    }
    .side-defenders td:first-child {
        border-left: 3px solid #1a73e8;
    }
    .side-attackers th,
    .side-attackers .badge {
        color: #d93025;
    }
    .side-attackers td:first-child {
        border-left: 3px solid #d93025;
    }
    .badge {
        display: inline-block;
        font-size: 0.7rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        margin-left: 0.5rem;
    }
</style>

<nav>
    <ul>
        <li><hgroup>
            <h1>Results: {{ result.scenario_name }}</h1>
            <p>Monte Carlo over <strong>{{ result.iterations }}</strong> iterations</p>
        </hgroup></li>
    </ul>
    <ul>
        <li><a href="/" role="button" class="secondary outline small">Back to Dashboard</a></li>
    </ul>
</nav>

<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js"></script>

{# ── CHARTS ───────────────────────────────────────────────────── #}
{% if result.defenders %}
<section>
    <h2>Charts</h2>
    <div class="grid" style="grid-template-columns: 1fr 1fr; gap: 2rem;">
        <article>
            <h3 style="color: #1a73e8;">🛡 Survival Rate</h3>
            <canvas id="chart-survival" height="180"></canvas>
        </article>
        <article>
            <h3 style="color: #555;">📊 Engagements per Defender</h3>
            <canvas id="chart-engagement" height="180"></canvas>
        </article>
    </div>
</section>

<script>
(function() {
    // ── Survival Rate ──────────────────────────────────────────
    new Chart(document.getElementById('chart-survival'), {
        type: 'bar',
        data: {
            labels: [{% for d in result.defenders %}"{{ d.name }}",{% endfor %}],
            datasets: [{
                label: 'Survival Rate (%)',
                data: [{% for d in result.defenders %}{{ d.survival_rate | round(precision=1) }},{% endfor %}],
                backgroundColor: [{% for d in result.defenders %}
                    {% if d.survival_rate >= 99.95 %}'#34a853'
                    {% elif d.survival_rate >= 50 %}'#1a73e8'
                    {% elif d.survival_rate >= 25 %}'#e37400'
                    {% else %}'#d93025'
                    {% endif %},
                {% endfor %}],
                borderColor: '#ffffff22',
                borderWidth: 1,
                borderRadius: 4,
                maxBarThickness: 40,
            }]
        },
        options: {
            indexAxis: 'y',
            responsive: true,
            plugins: {
                legend: { display: false },
            },
            scales: {
                x: {
                    min: 0,
                    max: 100,
                    grid: { color: '#00000015' },
                },
                y: {
                    grid: { display: false },
                }
            }
        }
    });

    // ── Hits vs Interceptors ───────────────────────────────────
    new Chart(document.getElementById('chart-engagement'), {
        type: 'bar',
        data: {
            labels: [{% for d in result.defenders %}"{{ d.name }}",{% endfor %}],
            datasets: [
                {
                    label: 'Avg Hits Taken',
                    data: [{% for d in result.defenders %}{{ d.avg_hits_taken | round(precision=2) }},{% endfor %}],
                    backgroundColor: '#e37400',
                    borderRadius: 4,
                    maxBarThickness: 30,
                },
                {
                    label: 'Avg Interceptors Fired',
                    data: [{% for d in result.defenders %}{{ d.avg_interceptors_fired | round(precision=2) }},{% endfor %}],
                    backgroundColor: '#1a73e8',
                    borderRadius: 4,
                    maxBarThickness: 30,
                },
            ]
        },
        options: {
            responsive: true,
            plugins: {
                legend: {
                    position: 'bottom',
                    labels: { boxWidth: 12, padding: 12 },
                },
            },
            scales: {
                x: {
                    grid: { display: false },
                },
                y: {
                    beginAtZero: true,
                    grid: { color: '#00000015' },
                }
            }
        }
    });
})();
</script>
{% endif %}

{# ── ATTACKERS (red) ──────────────────────────────────────────── #}
<section>
    <h2 style="color: #d93025;">
        ⚔ Attackers
        <small class="badge" style="color: #d93025;">Offensive</small>
    </h2>

    {% if result.attackers %}
    <figure>
        <table class="side-attackers">
            <thead>
                <tr>
                    <th>Platform</th>
                    <th>Target</th>
                    <th>Missiles</th>
                    <th>PKO</th>
                </tr>
            </thead>
            <tbody>
                {% for a in result.attackers %}
                <tr>
                    <td><strong>{{ a.name }}</strong></td>
                    <td>{{ a.target_name }}</td>
                    <td>{{ a.total_missiles }}</td>
                    <td>{{ a.pko_label }}</td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </figure>
    {% else %}
    <p>No attackers defined.</p>
    {% endif %}
</section>

{# ── DEFENDERS (blue) ────────────────────────────────────────── #}
<section>
    <h2 style="color: #1a73e8;">
        🛡 Defenders
        <small class="badge" style="color: #1a73e8;">Defensive</small>
    </h2>

    {% if result.defenders %}
    <figure>
        <table class="side-defenders">
            <thead>
                <tr>
                    <th>Platform</th>
                    <th>Staying Power</th>
                    <th>Survival Rate</th>
                    <th>Avg Hits Taken</th>
                    <th>Avg Interceptors Fired</th>
                </tr>
            </thead>
            <tbody>
                {% for d in result.defenders %}
                <tr>
                    <td><strong>{{ d.name }}</strong></td>
                    <td>{{ d.staying_power }}</td>
                    <td>{{ d.survival_rate | round(precision=2) }}%</td>
                    <td>{{ d.avg_hits_taken | round(precision=2) }} / {{ d.staying_power }}</td>
                    <td>{{ d.avg_interceptors_fired | round(precision=2) }} / {{ d.magazine_depth }}</td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </figure>
    {% else %}
    <p>No defenders defined.</p>
    {% endif %}
</section>

{% endblock %}
